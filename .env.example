# Copy to .env.local for local dev. On Vercel, set these in Project Settings > Environment Variables.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# true = return sample JSON without calling Gemini (no key needed)
MOCK_MODE=true
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
